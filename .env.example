# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Set a long random secret (at least 32 characters)
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Admin password used by /admin/login. Use a unique strong password.
ADMIN_PASSWORD="replace-with-a-unique-strong-password"
